# Template only. The real Secret is created directly in the cluster so no
# values end up in a file:
#
#   PW=$(python -c "import secrets; print(secrets.token_urlsafe(24))")
#   SK=$(python -c "import secrets; print(secrets.token_urlsafe(32))")
#   kubectl -n eps create secret generic eps \
#     --from-literal=POSTGRES_PASSWORD="$PW" \
#     --from-literal=SECRET_KEY="$SK" \
#     --from-literal=DATABASE_URL="postgresql+psycopg://eps:$PW@db:5432/eps"
apiVersion: v1
kind: Secret
metadata:
  name: eps
  namespace: eps
stringData:
  DATABASE_URL: postgresql+psycopg://eps:CHANGE_ME@db:5432/eps
  SECRET_KEY: CHANGE_ME
  POSTGRES_PASSWORD: CHANGE_ME
