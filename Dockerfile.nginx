# The official slim variant supplies the proxy modules used by nginx.conf.
# Pin the reviewed content; refresh the digest when security updates are needed.
FROM nginx:1.30-alpine-slim@sha256:77da26c31397bf6694b4bf93275f5b40b0b120ba1b8f114264b603e592c561d6

COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 80