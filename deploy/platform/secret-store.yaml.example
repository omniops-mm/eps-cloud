metadata:
  name: google-secrets
  namespace: monitoring
spec:
  provider:
    gcpsm:
      projectID: REPLACE_WITH_YOUR_PROJECT_ID
      auth:
        workloadIdentityFederation:
          audience: //iam.googleapis.com/projects/REPLACE_PROJECT_NUMBER/locations/global/workloadIdentityPools/REPLACE_POOL/providers/REPLACE_PROVIDER
          serviceAccountRef:
            name: eps-secrets
            audiences:
              - https://iam.googleapis.com/projects/REPLACE_PROJECT_NUMBER/locations/global/workloadIdentityPools/REPLACE_POOL/providers/REPLACE_PROVIDER
