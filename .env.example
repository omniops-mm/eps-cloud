# Copy to .env and fill in. The real .env is gitignored and never committed.

# Postgres connection string: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=

# Flask session signing key. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Local Postgres password, used by compose for the db and the app URL
POSTGRES_PASSWORD=