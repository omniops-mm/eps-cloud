# Copy outside the repository and replace every CHANGE_ME before applying.
# Keep passwords out of command arguments and shell history.
apiVersion: v1
kind: Secret
metadata:
  name: eps
  namespace: eps
stringData:
  DATABASE_URL: postgresql+psycopg://eps:CHANGE_ME@db:5432/eps
  SECRET_KEY: CHANGE_ME
  POSTGRES_PASSWORD: CHANGE_ME
